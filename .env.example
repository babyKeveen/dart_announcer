# Station name or Irish Rail station code (e.g. "Sutton" or "SUTTN")
STATION=Sutton

# Optional: "Northbound", "Southbound", or blank for both directions
DIRECTION=

# How far ahead to look, in minutes (Irish Rail API allows 5-90)
NUM_MINS=90

# Max number of upcoming departures to return/display
MAX_DEPARTURES=5

# Display aesthetic style: "solari" (Solari di Udine split-flap), "matrix" (Dot Matrix Indicator), or "plain" (Minimalist tabular grid)
DISPLAY_STYLE=solari

# Optional: TRMNL Custom Plugin Webhook URL to push data directly to an e-ink panel
# TRMNL_WEBHOOK_URL=https://usetrmnl.com/api/custom_plugins/YOUR_PLUGIN_UUID

